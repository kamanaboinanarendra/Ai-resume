# Database Connection (PostgreSQL with psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_resume_builder

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database Connection (PostgreSQL with psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_resume_builder

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Email Delivery Configuration (SMTP for Forgot Password & Verification Codes)
# -----------------------------------------------------------------------------------------
# Gmail Configuration (Recommended for testing):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_16_char_google_app_password (Create at: https://myaccount.google.com/apppasswords)
#   EMAIL_FROM=your_email@gmail.com
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
#   SMTP_SECURE=false
#
# Outlook / Office365 Configuration:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@outlook.com
#   SMTP_PASSWORD=your_password_or_app_password
#
# Brevo (Sendinblue) / SendGrid / Mailgun / AWS SES:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your_smtp_login
#   SMTP_PASSWORD=your_smtp_key
# -----------------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@airesumebuilder.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_SECURE=false

# Frontend Origin and Server Port
FRONTEND_URL=http://localhost:5173
PORT=8000


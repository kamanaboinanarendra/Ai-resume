# Backend-only (non-Docker) development settings.
# For the normal Docker deployment use the ROOT .env.example instead --
# one `docker compose up` from the repository root runs everything.
#
# Exactly THREE variables are mandatory -- the app refuses to start
# without them: POSTGRES_URI, JWT_SECRET_KEY, GEMINI_API_KEY.
# Everything else is auto-detected / defaulted (see app/core/config.py).

# 🔴 MANDATORY -------------------------------------------------------------
# 1. Full PostgreSQL URI (postgres:// / postgresql+psycopg:// also work).
POSTGRES_URI=postgresql://postgres:postgres@localhost:5433/ai_resume_builder
# 2. Generate: openssl rand -hex 32
JWT_SECRET_KEY=
# 3. From Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# 🟢 OPTIONAL --------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# DOMAIN=example.com or PUBLIC_URL=https://example.com derive CORS +
# Secure cookies. Empty = same-origin (integrated app).
DOMAIN=
PUBLIC_URL=
PORT=8000

# Password-reset e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

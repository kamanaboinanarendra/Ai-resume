# Backend-only (non-Docker) development settings.
# For the normal Docker deployment use the ROOT .env.example instead --
# one `docker compose up` from the repository root runs everything.
#
# Only JWT_SECRET_KEY (production) and an AI key (AI features) are
# important; everything else is auto-detected / defaulted. See
# app/core/config.py.

# Database: a full URL, or POSTGRES_HOST/POSTGRES_PORT/POSTGRES_DB/
# POSTGRES_USER/POSTGRES_PASSWORD components it is assembled from.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_resume_builder

# IMPORTANT in production. Empty = auto-generated per boot (warning printed).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IMPORTANT only for AI features (either provider).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# OPTIONAL: DOMAIN=example.com or PUBLIC_URL=https://example.com
# derive CORS + Secure cookies. Empty = same-origin (integrated app).
DOMAIN=
PUBLIC_URL=
PORT=8000

# OPTIONAL: password-reset e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ==========================================================================
# AI Resume Builder -- environment configuration
#
#     cp .env.example .env   &&   docker compose up --build
#
# ZERO configuration is required to boot: `docker compose up` works
# with no .env at all. Below, ONLY the variables marked IMPORTANT
# matter for a real deployment. Everything else is OPTIONAL and is
# auto-detected or falls back to a sensible default.
# ==========================================================================

# --------------------------------------------------------------------------
# 🔴 IMPORTANT -- set these for production
# --------------------------------------------------------------------------

# Signs login tokens. If left empty, one is generated automatically and
# persisted in the `app_secrets` Docker volume (logins survive restarts,
# but not a volume wipe or multi-replica deploys -- set it there).
# Generate:  openssl rand -hex 32
JWT_SECRET_KEY=

# Database password for the bundled PostgreSQL container.
# (Ignored when DATABASE_URL below points at an external database.)
POSTGRES_PASSWORD=postgres

# --------------------------------------------------------------------------
# 🟡 IMPORTANT -- only if you want the AI features
# The builder, templates, autosave and PDF export work 100% without a
# key; AI chat / improve / job-match reply with a "not configured"
# notice instead. Provide EITHER key:
# --------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --------------------------------------------------------------------------
# 🟢 OPTIONAL -- auto-detected / sensible defaults (leave as-is normally)
# --------------------------------------------------------------------------

# Your domain, e.g. DOMAIN=resumes.example.com
# Auto-detected when empty: the app is domain-agnostic (relative /api
# URLs, catch-all nginx, same-origin cookies), so it works on
# localhost, an IP, or any hostname. Setting DOMAIN only pins the
# nginx server_name and makes CORS / Secure-cookie decisions explicit.
DOMAIN=
# Full public URL override, e.g. PUBLIC_URL=https://resumes.example.com
# (wins over DOMAIN; set https:// here to get Secure auth cookies).
PUBLIC_URL=

# Published nginx port on the host.
HTTP_PORT=80

# Database: components for the bundled Postgres, OR one full URL for an
# external/managed database (then the `db` service can be dropped).
POSTGRES_DB=ai_resume_builder
POSTGRES_USER=postgres
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/ai_resume_builder

# Models & session lifetime.
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_MODEL=openrouter/free
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Extra CORS origins (comma-separated) -- only for split deployments
# where a frontend is hosted on a different origin.
CORS_ORIGINS=

# Password-reset e-mail (SMTP). Optional; without it the forgot-
# password flow reports e-mail is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ==========================================================================
# AI Resume Builder -- environment configuration
#
#     cp .env.example .env   # fill in the 3 mandatory variables below
#     docker compose up --build
#
# Exactly THREE variables are mandatory -- the app (and compose)
# refuse to start without them, with a message naming what is
# missing. Everything else is OPTIONAL and auto-detected/defaulted.
# ==========================================================================

# --------------------------------------------------------------------------
# 🔴 MANDATORY
# --------------------------------------------------------------------------

# 1. Full PostgreSQL connection URI (no separate host/user/password
#    variables -- the URI is the whole configuration). Managed
#    Postgres (Neon, Supabase, Railway, RDS, ...) or your own server:
#      postgresql://user:password@host:5432/ai_resume_builder
#    postgres:// and postgresql+psycopg:// forms are also accepted.
#    A Postgres on your host machine works too, via host.docker.internal:
#      postgresql://user:password@host.docker.internal:5432/ai_resume_builder
POSTGRES_URI=

# 2. Secret that signs login tokens. Generate one:
#      openssl rand -hex 32
JWT_SECRET_KEY=

# 3. Google Gemini API key (Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=

# --------------------------------------------------------------------------
# 🟢 OPTIONAL -- auto-detected / sensible defaults (leave as-is normally)
# --------------------------------------------------------------------------

# Your domain, e.g. DOMAIN=resumes.example.com
# Auto-detected when empty: the app is domain-agnostic (relative /api
# URLs, catch-all nginx, same-origin cookies), so it works on
# localhost, an IP, or any hostname. Setting DOMAIN only pins the
# nginx server_name and makes CORS / Secure-cookie decisions explicit.
DOMAIN=
# Full public URL override, e.g. PUBLIC_URL=https://resumes.example.com
# (wins over DOMAIN; set https:// here to get Secure auth cookies).
PUBLIC_URL=

# Published nginx port on the host.
HTTP_PORT=80

# Models & session lifetime.
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Extra CORS origins (comma-separated) -- only for split deployments
# where a frontend is hosted on a different origin.
CORS_ORIGINS=

# Password-reset e-mail (SMTP). Optional; without it the forgot-
# password flow reports e-mail is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Legacy alias for POSTGRES_URI (POSTGRES_URI wins if both are set):
# DATABASE_URL=
